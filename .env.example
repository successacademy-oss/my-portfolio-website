# ─────────────────────────────────────────────────────────────
# PUBLIC Firebase client config (safe to expose in the browser —
# this is normal for Firebase; access is restricted by security
# rules and server-side checks, NOT by hiding these values).
# Get these from: Firebase Console → Project Settings → General →
# "Your apps" → Web app → SDK setup and configuration.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# PRIVATE Firebase Admin SDK credentials — SERVER ONLY.
# Never prefix these with NEXT_PUBLIC_. Never commit this file.
# Get these from: Firebase Console → Project Settings →
# Service accounts → Generate new private key.
# Paste the private_key value exactly, keeping \n escape codes.
# ─────────────────────────────────────────────────────────────
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
# The ONE Firebase Auth UID that is allowed to use the admin
# dashboard. Create yourself a user in Firebase Auth (email/
# password), copy their UID from the console, and put it here.
# The backend checks every admin request against this value —
# it is never trusted from the browser.
# ─────────────────────────────────────────────────────────────
ADMIN_UID=
